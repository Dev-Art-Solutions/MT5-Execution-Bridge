ENVIRONMENT=development

HOST=127.0.0.1
PORT=8200

DRY_RUN=true
LIVE_EXECUTION_ENABLED=false

DATABASE_PATH=./data/bridge.db

# MT5_SERVER and MT5_LOGIN are required when DRY_RUN=false and
# LIVE_EXECUTION_ENABLED=true (also used to namespace daily risk state per
# broker/account). MT5_PASSWORD is not required if the terminal already
# has an authenticated session.
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

MAGIC_NUMBER=881100

MAX_RISK_PERCENT=1.0
MAX_DAILY_LOSS_PERCENT=3.0
MAX_OPEN_POSITIONS=3
MAX_TRADES_PER_DAY=5
MAX_SPREAD_POINTS=30

REQUIRE_STOP_LOSS=true
ALLOW_MARKET_BUY=true
ALLOW_MARKET_SELL=true

MAX_SIGNAL_AGE_SECONDS=60

SYMBOL_MAP_PATH=./examples/symbol-map.example.json

ALLOW_REMOTE_BINDING=false
